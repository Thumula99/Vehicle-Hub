# =============================================================================
# 🚗 Vehicle-Hub - Comprehensive .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# 1. .NET & C# Build Artifacts (Core, ASP.NET Core, EF Core)
# -----------------------------------------------------------------------------
**/bin/
**/obj/
[Bb]in/
[Oo]bj/
ServerCSharp/bin/
ServerCSharp/obj/
server/bin/
server/obj/

# Compiled Assemblies and Debug Files
*.dll
*.pdb
*.exe
*.so
*.dylib

# Visual Studio & Rider Project Cache / User Settings
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.sln.DotSettings.user
*.ide
*.cache
*.FileListAbsolute.txt
*.Up2Date
*.assets.cache

# NuGet Packages & Intermediate Output
*.nupkg
*.snupkg
**/project.assets.json
**/project.nuget.cache
**/project.lock.json
**/project.fragment.lock.json
**/artifacts/

# Test Results & Code Coverage
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# -----------------------------------------------------------------------------
# 2. Node.js & Next.js Build Outputs (client & server)
# -----------------------------------------------------------------------------
**/node_modules/
.next/
out/
build/
dist/
.vercel/
/.pnp
.pnp.js
.pnp.*

# Package Manager Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
appsettings.*.local.json
appsettings.Secrets.json
appsettings.Production.json

# Certificates & Private Keys
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# -----------------------------------------------------------------------------
# 4. User Uploads & Media Storage
# -----------------------------------------------------------------------------
server/uploads/*
!server/uploads/.gitkeep
*.tmp

# -----------------------------------------------------------------------------
# 5. OS Metadata & Temporary Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.hidden

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# -----------------------------------------------------------------------------
# 6. IDEs & Code Editors
# -----------------------------------------------------------------------------
# JetBrains (Rider, WebStorm, IntelliJ)
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
